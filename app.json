{
  "expo": {
    "name": "Stock & QR Inventory",
    "slug": "stock-qr-inventory-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stockqr",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#0F766E",
    "android": {
      "package": "com.stockqr.inventory",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stock & QR Inventory to use the camera to scan product QR codes and factory barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
