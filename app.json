{
  "expo": {
    "name": "Stock & QR Inventory",
    "slug": "stock-qr-inventory-app",
    "version": "2.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "primaryColor": "#0D9488",
    "android": {
      "package": "com.stockqr.inventory",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0D9488"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stock & QR Inventory to use the camera to scan product QR codes and factory barcodes."
        }
      ]
    ]
  }
}
