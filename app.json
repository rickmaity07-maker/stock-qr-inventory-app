{
  "expo": {
    "name": "Stock & QR Inventory",
    "slug": "stock-qr-inventory-app",
    "version": "2.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "primaryColor": "#007AFF",
    "android": {
      "package": "com.stockqr.inventory",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stock & QR Inventory to use the camera to scan product QR codes and factory barcodes."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockqr.inventory",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan product QR codes and factory barcodes."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Stock & QR Inventory",
      "shortName": "Stock QR",
      "themeColor": "#F2F2F7",
      "backgroundColor": "#F2F2F7",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/stock-qr-inventory-app/app"
    },
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    }
  }
}
