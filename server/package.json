{
  "name": "stock-qr-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Stock & QR Inventory (Hono on Vercel + Neon Postgres)",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "migrate": "tsx scripts/migrate.ts",
    "set-password": "tsx scripts/set-password.ts",
    "backup": "tsx scripts/backup.ts",
    "decrypt-backup": "tsx scripts/decrypt-backup.ts",
    "errors": "tsx scripts/errors.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
